</Panel>
<Label id="status" class="Status" text="{s:text}" hittest="false" />
<Panel class="Footer">
<Button id="back" class="Action"><Label id="back_label" text="Назад" hittest="false" /></Button>
<Button id="previous" class="Action"><Label id="previous_label" text="‹" hittest="false" /></Button>
<Button id="next" class="Action"><Label id="next_label" text="›" hittest="false" /></Button>
<Panel class="FooterSpacer" hittest="false" />
