<root>
<styles><include src="s2r://panorama/styles/custom_game/retake17.vcss_c" /></styles>
<Panel class="Outer" hittest="false">
<Panel id="menu" class="Menu" hittest="false">
<Panel class="Card">

<Button id="close" class="Close">
  <Panel class="Cross Slash" hittest="false" />
  <Panel class="Cross Backslash" hittest="false" />
</Button>
<Panel id="intro" class="Intro">
  <Label class="Kicker" text="RETAKE #17" hittest="false" />
  <Panel class="IntroRow">
    <Panel class="IntroCopy">
      <Label class="Headline" text="Как играть&#10;в ретейк" hittest="false" />
      <Label class="Muted" text="Бомба уже на точке A или B." hittest="false" />
    </Panel>
    <Panel class="Hero" hittest="false">
      <Panel class="Agent AgentCt" hittest="false" />
      <Panel class="Agent AgentT" hittest="false" />
      <Label class="MapName" text="MIRAGE · A" hittest="false" />
    </Panel>
  </Panel>
  <Panel class="RoleRow">
    <Panel class="Role Defender">
      <Panel class="RoleIcon CtIcon" hittest="false" />
      <Panel class="RoleCopy">
        <Label class="RoleName Blue" text="Защита · CT" hittest="false" />
        <Label class="Goal" text="Обезвредь бомбу." hittest="false" />
      </Panel>
    </Panel>
    <Panel class="Role Attacker">
      <Panel class="RoleIcon TIcon" hittest="false" />
      <Panel class="RoleCopy">
        <Label class="RoleName Orange" text="Атака · T" hittest="false" />
        <Label class="Goal" text="Защити бомбу до взрыва." hittest="false" />
      </Panel>
    </Panel>
  </Panel>
  <Panel class="Footer">
    <Button id="intro_commands" class="Action"><Label text="Команды" hittest="false" /></Button>
    <Button id="intro_skip" class="Action Check">
      <Panel class="Checkbox" hittest="false" /><Label text="Больше не показывать" hittest="false" />
    </Button>
    <Panel class="FooterSpacer" hittest="false" />
    <Button id="intro_close" class="Action Primary"><Label text="Понятно" hittest="false" /></Button>
  </Panel>
</Panel>
<Panel id="body" class="Body">
  <Label class="Kicker" text="RETAKE #17" hittest="false" />
  <Panel class="Heading">
    <Label id="title" class="Title" text="{s:text}" hittest="false" />
    <Panel id="team_picker" class="TeamPicker">
      <Button id="gear_t" class="TeamOption AttackOption">
        <Panel class="TeamBadge TIcon" hittest="false" />
        <Label text="T" hittest="false" />
      </Button>
      <Button id="gear_ct" class="TeamOption DefendOption">
        <Panel class="TeamBadge CtIcon" hittest="false" />
        <Label text="CT" hittest="false" />
      </Button>
    </Panel>
  </Panel>
  <Panel id="caption" class="Caption">
    <Panel id="team" class="TeamLogo" hittest="false" />
    <Label id="subtitle" class="Muted" text="{s:text}" hittest="false" />
  </Panel>
<Panel class="GridRow">
<Button id="item_0" class="Item">
  <Panel class="ItemIconWell" hittest="false">
    <Panel id="icon_0" class="ItemIcon" hittest="false" />
  </Panel>
  <Panel class="ItemCopy" hittest="false">
    <Label id="name_0" class="ItemName" text="{s:text}" hittest="false" />
    <Label id="detail_0" class="ItemDetail" text="{s:text}" hittest="false" />
  </Panel>
  <Panel class="Arrow" hittest="false" />
</Button>
